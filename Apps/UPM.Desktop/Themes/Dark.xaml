<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 다크 테마 팔레트 (Light.xaml과 키 동일하게 유지할 것) -->

    <!-- 베이스 -->
    <SolidColorBrush x:Key="Brush.WindowBg" Color="#17171A"/>
    <SolidColorBrush x:Key="Brush.PanelBg" Color="#232326"/>
    <SolidColorBrush x:Key="Brush.PanelBgElevated" Color="#2C2C30"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#3D3D42"/>
    <SolidColorBrush x:Key="Brush.RowStripe" Color="#1E1E22"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#38383C"/>
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#353539"/>
    <SolidColorBrush x:Key="Brush.TabHover" Color="#28282C"/>

    <!-- 텍스트 -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#AEAEB2"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8E8E93"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#636366"/>
    <SolidColorBrush x:Key="Brush.GaugeValueText" Color="#FFFFFF"/>

    <!-- 액센트 -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#34C759"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#40D965"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#28A745"/>
    <SolidColorBrush x:Key="Brush.IconTint" Color="#64D2FF"/>

    <!-- 도움말 아이콘 배경 -->
    <SolidColorBrush x:Key="Brush.HelpIconBg" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Brush.HelpIconBgHover" Color="#40FFFFFF"/>

    <!-- 게이지 빈 영역 -->
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#4C4C54"/>
    <Color x:Key="Color.ArcTrack">#4C4E56</Color>

    <!-- 위험(종료) 버튼 -->
    <SolidColorBrush x:Key="Brush.DangerBg" Color="#3D2424"/>
    <SolidColorBrush x:Key="Brush.DangerBgHover" Color="#5A2828"/>
    <SolidColorBrush x:Key="Brush.DangerText" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="Brush.DangerTextHover" Color="#FF8888"/>
</ResourceDictionary>
