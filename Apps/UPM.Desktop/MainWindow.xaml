<Window x:Class="UPM.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Universal PC Master" Height="600" Width="900" Background="#121212">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단: 하드웨어 사양 및 부스트 버튼 -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,40,0" Width="250">
                    <TextBlock Text="SYSTEM SPECS" Foreground="#00FF00" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="CpuNameText" Text="CPU: Loading..." Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MainboardText" Text="MB: Loading..." Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Width="250">
                    <TextBlock Text="MEMORY &amp; GPU" Foreground="#00FF00" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="RamTotalText" Text="Total RAM: Loading..." Foreground="White" FontSize="12"/>
                    <TextBlock x:Name="GpuNameText" Text="GPU: Loading..." Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 부스트 버튼 (C#에서 BoostButton으로 호출됨) -->
                <Button x:Name="BoostButton" 
                        Click="BoostButton_Click"
                        Content="QUICK BOOST" 
                        Background="#FF4500" Foreground="White" 
                        FontWeight="Bold" Width="140" Height="45" 
                        Margin="60,0,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- 하단: 실시간 모니터링 게이지 -->
        <UniformGrid Grid.Row="1" Columns="3">
            <!-- CPU 게이지 -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CPU USAGE" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10" FontWeight="Bold"/>
                <lvc:AngularGauge x:Name="CpuGauge" Value="0" FromValue="0" ToValue="100" 
                                  LabelsStep="25" TicksStep="5" Wedge="250" Height="200"
                                  Foreground="White" FontSize="12" FontWeight="Bold">
                    <lvc:AngularGauge.Sections>
                        <lvc:AngularSection FromValue="0" ToValue="70" Fill="#00FF00"/>
                        <lvc:AngularSection FromValue="70" ToValue="90" Fill="#FFA500"/>
                        <lvc:AngularSection FromValue="90" ToValue="100" Fill="#FF0000"/>
                    </lvc:AngularGauge.Sections>
                </lvc:AngularGauge>
            </StackPanel>

            <!-- RAM 게이지 -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RAM ALLOCATION" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10" FontWeight="Bold"/>
                <lvc:AngularGauge x:Name="RamGauge" Value="0" FromValue="0" ToValue="100" 
                                  Wedge="250" Height="200" Foreground="White"/>
            </StackPanel>

            <!-- GPU 게이지 -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="GPU TEMP" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10" FontWeight="Bold"/>
                <lvc:AngularGauge x:Name="GpuGauge" Value="0" FromValue="0" ToValue="110" 
                                  Wedge="250" Height="200" Foreground="White">
                    <lvc:AngularGauge.Sections>
                        <lvc:AngularSection FromValue="0" ToValue="60" Fill="#00FF00"/>
                        <lvc:AngularSection FromValue="60" ToValue="80" Fill="#FFA500"/>
                        <lvc:AngularSection FromValue="80" ToValue="110" Fill="#FF0000"/>
                    </lvc:AngularGauge.Sections>
                </lvc:AngularGauge>
            </StackPanel>
        </UniformGrid>
    </Grid>
</Window>