<Window x:Class="UPM.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:UPM.Desktop.ViewModels"
        xmlns:m="clr-namespace:UPM.Models;assembly=UPM.Models"
        xmlns:conv="clr-namespace:UPM.Desktop.Converters"
        mc:Ignorable="d"
        Title="UPM - Universal PC Master"
        Width="720"
        SizeToContent="Height"
        MinHeight="480"
        ResizeMode="NoResize"
        MinWidth="720" MaxWidth="720"
        Background="#1C1C1E"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_OnLoaded">

    <Window.Resources>
        <conv:WorkingSetMegabytesConverter x:Key="WsMbConverter"/>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="ResourceLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="ResourceValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E5EA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ProcessToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#E5E5EA"/>
            <Setter Property="Background" Value="#3A3A3C"/>
            <Setter Property="BorderBrush" Value="#48484A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#48484A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#444446"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:DashboardViewModel />
    </Window.DataContext>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단: SYSTEM RESOURCES (좌) | 균형 여백 | UPM + QUICK BOOST (우) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="SYSTEM RESOURCES"
                               Foreground="#AEAEB2" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#1C1C1E" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="항목" Style="{StaticResource ResourceLabel}" Margin="0"/>
                                <TextBlock Grid.Column="1" Text="사양" Foreground="#8E8E93" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="CPU" Style="{StaticResource ResourceLabel}"/>
                        <TextBlock x:Name="CpuNameText" Grid.Row="1" Grid.Column="1" Text="Loading…" Style="{StaticResource ResourceValue}" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="GPU" Style="{StaticResource ResourceLabel}"/>
                        <TextBlock x:Name="GpuNameText" Grid.Row="2" Grid.Column="1" Text="Loading…" Style="{StaticResource ResourceValue}" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="RAM" Style="{StaticResource ResourceLabel}"/>
                        <TextBlock x:Name="RamTotalText" Grid.Row="3" Grid.Column="1" Text="Loading…" Style="{StaticResource ResourceValue}" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="MB" Style="{StaticResource ResourceLabel}"/>
                        <TextBlock x:Name="MainboardText" Grid.Row="4" Grid.Column="1" Text="Loading…" Style="{StaticResource ResourceValue}"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" MinWidth="12"/>

            <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                <TextBlock Text="UPM" Foreground="#FFFFFF" FontSize="22" FontWeight="Light" HorizontalAlignment="Right"/>
                <TextBlock Text="Universal PC Master" Foreground="#636366" FontSize="9" Margin="0,2,0,0"
                           HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="200"/>
                <Button x:Name="BoostButton" Content="QUICK BOOST"
                        Background="#30D158" Foreground="White" FontWeight="Bold" FontSize="11"
                        Padding="14,12" Margin="0,10,0,0" HorizontalAlignment="Right" MinWidth="100"
                        Click="BoostButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 게이지 전용 -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="GAUGES" Foreground="#AEAEB2" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <UniformGrid Rows="1" Columns="3">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2">
                        <lvc:PieChart Series="{Binding CpuGauge}"
                                      Background="Transparent"
                                      InitialRotation="-225" MaxAngle="270" IsClockwise="True"
                                      Width="132" Height="132"
                                      TooltipPosition="Hidden" IsHitTestVisible="False"/>
                        <TextBlock Text="CPU" Foreground="#E5E5EA" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2">
                        <lvc:PieChart Series="{Binding RamGauge}"
                                      Background="Transparent"
                                      InitialRotation="-225" MaxAngle="270" IsClockwise="True"
                                      Width="132" Height="132"
                                      TooltipPosition="Hidden" IsHitTestVisible="False"/>
                        <TextBlock Text="RAM" Foreground="#E5E5EA" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2">
                        <lvc:PieChart Series="{Binding GpuGauge}"
                                      Background="Transparent"
                                      InitialRotation="-225" MaxAngle="270" IsClockwise="True"
                                      Width="132" Height="132"
                                      TooltipPosition="Hidden" IsHitTestVisible="False"/>
                        <TextBlock Text="GPU" Foreground="#E5E5EA" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- 메모리 / 프로세스 전용 -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <ToggleButton x:Name="ProcessListToggle" DockPanel.Dock="Right"
                                  Style="{StaticResource ProcessToggleStyle}"
                                  IsChecked="True"
                                  Checked="ProcessListToggle_OnChecked"
                                  Unchecked="ProcessListToggle_OnUnchecked"/>
                    <TextBlock Text="메모리 사용 상위" VerticalAlignment="Center"
                               Foreground="#AEAEB2" FontSize="10" FontWeight="SemiBold"/>
                </DockPanel>

                <StackPanel x:Name="ProcessDetailsHost">
                    <Grid x:Name="ProcessListHeader" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="이름" Foreground="#636366" FontSize="9" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="PID" Foreground="#636366" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="메모리" Foreground="#636366" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <ScrollViewer x:Name="ProcessScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="TopProcessItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:ProcessInfoModel}">
                                    <Border BorderBrush="#48484A" BorderThickness="0,0,0,1" Padding="0,6,0,6" Margin="0,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ProcessName}" Foreground="#E5E5EA" FontSize="10"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessName}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProcessId}" Foreground="#8E8E93" FontSize="10" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding MemoryWorkingSetBytes, Converter={StaticResource WsMbConverter}}"
                                                       Foreground="#AEAEB2" FontSize="10" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
