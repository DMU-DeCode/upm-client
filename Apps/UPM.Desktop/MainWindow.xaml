<Window x:Class="UPM.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UPM - 실시간 모니터링 테스트" Height="300" Width="400" Background="#1E1E1E">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="실시간 CPU 사용량" Foreground="White" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="CpuText" Text="0.0" Foreground="#00FF00" FontSize="60" FontWeight="Bold"/>
                <TextBlock Text="%" Foreground="#00FF00" FontSize="20" VerticalAlignment="Bottom" Margin="5,0,0,10"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Text="Stable" Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Margin="20">
            <Border Background="#2D2D2D" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="HARDWARE SPECS" Foreground="#00FF00" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="CpuNameText" Text="CPU: Loading..." Foreground="White" Margin="0,2"/>
                    <TextBlock x:Name="GpuNameText" Text="GPU: Loading..." Foreground="White" Margin="0,2"/>
                    <TextBlock x:Name="RamTotalText" Text="RAM: Loading..." Foreground="White" Margin="0,2"/>
                    <TextBlock x:Name="MainboardText" Text="MB: Loading..." Foreground="White" Margin="0,2"/>
                </StackPanel>
            </Border>

            <TextBlock Text="REAL-TIME MONITOR" Foreground="#00FF00" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="CpuUsageText" Text="CPU Usage: 0%" Foreground="White" FontSize="20"/>
        </StackPanel>
    </Grid>
</Window>